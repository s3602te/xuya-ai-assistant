# ============================
# 基礎映像檔與工作環境設定開始
# ============================
# 1.使用輕量級的 Python 3.11 作為基底環境
FROM python:3.11-slim
# 2.設定容器內部的工作目錄 後續所有的 COPY 與 RUN 指令皆會以此絕對路徑為基準
WORKDIR /app
# ============================
# 基礎映像檔與工作環境設定結束
# ============================

# ============================
# 依賴套件安裝與快取最佳化開始
# ============================
# 1. 先把 requirements.txt 複製進去並安裝套件 (這層會被快取，若總表未變動 後續編譯會加速)
COPY requirements.txt .
# 2. 行套件批次安裝：加上 --no-cache-dir 參數可避免殘留安裝暫存檔，進一步達成容器瘦身 (Image Shrinking)
RUN pip install --no-cache-dir -r requirements.txt
# ============================
# 依賴套件安裝與快取最佳化結束
# ============================


# ============================
# 專案原始碼掛載與啟動設定開始
# ============================
# 1. 複製專案實體檔案：將宿主機 (Host) 上的後端源碼 (含 app.py, dist 前端靜態檔, xuya_vdb 資料庫目錄等) 完全複製至容器內部
COPY . .
# 2. 宣告這個容器會對外開啟 5000 Port (用於對接前端與外部 API)
EXPOSE 5000
# 3.當容器成功啟動後，預設執行的系統服務啟動腳本 例如啟動 Flask 伺服器
CMD ["python", "app.py"]
# ============================
# 專案原始碼掛載與啟動設定結束
# ============================